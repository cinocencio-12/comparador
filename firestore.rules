rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function verified() { return request.auth.token.email_verified == true; }
    match /profiles/{uid} {
      allow read: if signed() && (request.auth.uid == uid || (verified() && myEmail() in resource.data.sharedWith));
      allow write: if signed() && request.auth.uid == uid;
    }
    match /users/{uid}/items/{itemId} {
      allow read, write: if signed() && request.auth.uid == uid;
      allow read: if signed() && verified() && myEmail() in resource.data.visibleTo;
      match /images/{imgId} {
        allow read, write: if signed() && request.auth.uid == uid;
        allow read: if signed() && verified() && myEmail() in get(/databases/$(db)/documents/users/$(uid)/items/$(itemId)).data.visibleTo;
      }
    }
    // Reservas de regalos («lo compro yo»). Las ven las personas con quien el dueño comparte;
    // el dueño solo las ve si es un regalo para otra persona (hideOwner == false).
    match /reservations/{owner}/items/{itemId} {
      function sharer() { return verified() && myEmail() in get(/databases/$(db)/documents/profiles/$(owner)).data.sharedWith; }
      allow read: if signed() && (sharer() || (request.auth.uid == owner && resource.data.hideOwner == false));
      allow create, update: if signed() && sharer() && request.resource.data.by == myEmail();
      allow delete: if signed() && sharer() && resource.data.by == myEmail();
    }
  }
}
