{
  "name": "Comparador de Compras",
  "short_name": "Comparador",
  "description": "Comparte una captura o un enlace de una tienda y se guarda con precio, descuento y envío.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3F5F1",
  "theme_color": "#0F6B5C",
  "lang": "es",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "shots", "accept": ["image/png", "image/jpeg", "image/webp"] }
      ]
    }
  }
}
